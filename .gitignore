# Arquivo .gitignore (na pasta raiz 'Aplicativo-Oncologico')

# Secrets
**/.env

# --- Arquivos de IDE e OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Backend (Python/Django) ---
backend/__pycache__/
backend/*.pyc
*.log
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Se você criar um 'venv' local futuramente
backend/venv/
backend/env/

# Se você usar o sqlite para testes
backend/db.sqlite3

# --- Frontend (Node/Expo) ---
frontend/node_modules/
frontend/.expo/
frontend/npm-debug.log*
frontend/yarn-error.log*
frontend/.web-build/
frontend/dist/
frontend/build/
frontend/web-build/
frontend/.expo-shared/
frontend/.turbo/
frontend/.parcel-cache/

__pycache__/
**/__pycache__/
**/*.pyc

# Django uploads/build artifacts
backend/media/
backend/staticfiles/

# Docker volumes
postgres-data/
docker-data/